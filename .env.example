# Copy to .env and fill in. .env is gitignored.
#
#   cp .env.example .env
#
# Then on Casper, before submitting:
#   source .env && qsub src/sweep/submit_res250.pbs
#
# Or put the PBS_ACCOUNT line in ~/.bashrc once and never think about it again.

export PBS_ACCOUNT="uosc0035"
export PBS_EMAIL="you@example.edu"

# Julia depot. The trailing colon is required: without it this replaces the
# depot list instead of prepending, dropping Julia's bundled stdlib depot.
export JULIA_DEPOT="/glade/work/nguyen/.julia_v111:"
