#!/bin/bash -l
#═══════════════════════════════════════════════════════════════════════════
# Diamond Shoals cape LES (src/les_shoal.jl), full resolution (f1), A100
#═══════════════════════════════════════════════════════════════════════════
# Submit:  qsub src/submit_les_f1.pbs.template
#
# Two configurations at f1: 4 m horizontally, 1 m vertically near the top,
# 800 x 1600 x ~68 = ~87 M cells (Chor & Wenegrat ran 85 M on A100s).
# Estimated ~1-2 days each: expect to submit this script twice; the second
# submission continues from the checkpoints.
#
# Each array index runs one configuration of src/les_shoal.jl (listed in the
# case statement below) at resolution f1. A run that hits the 23 h wall-
# time limit writes a checkpoint and stops; submitting this script again picks
# every unfinished run up from its last checkpoint (finished runs stop at once).
#
# .template: see the note in src/sweep/submit_diamond.pbs.template.
#═══════════════════════════════════════════════════════════════════════════

#PBS -A UOSC0035
#PBS -N les_f1
#PBS -k eod
#PBS -o logs/les_f1.out
#PBS -e logs/les_f1.err
#PBS -l walltime=24:00:00
#PBS -q casper
#PBS -l select=1:ncpus=4:ngpus=1:gpu_type=a100:mem=64gb
#PBS -m abe
#PBS -J 1-2

module purge
module load ncarenv-basic/24.12
module load ncarenv/24.12
module load julia/1.11.2
module load peak-memusage
module li

PROJECT_DIR="/glade/work/nguyen/unc-shoals"
cd "${PROJECT_DIR}"
mkdir -p logs out/les /glade/derecho/scratch/nguyen/unc-shoals/les

case "${PBS_ARRAY_INDEX}" in
    1) CONFIG=DS_base ;;
    2) CONFIG=DS_summer ;;
    *) echo "ERROR: no configuration for array index ${PBS_ARRAY_INDEX}"; exit 1 ;;
esac

echo "════════════════════════════════════════════════════════"
echo " LES:   ${CONFIG} f1  (array index ${PBS_ARRAY_INDEX})"
echo " Host:  $(hostname)"
echo " GPU:   $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo 'N/A')"
echo " Date:  $(date)"
echo "════════════════════════════════════════════════════════"

peak_memusage julia --project=. src/les_shoal.jl ${CONFIG} f1 \
    2>&1 | tee -a out/les/LES_${CONFIG}_f1.log

echo "LES ${CONFIG} f1 stopped at $(date)"
