#!/bin/bash -l
#═══════════════════════════════════════════════════════════════════════════
# PBS Job Array Script for NCAR Casper GPU Parameter Sweep
#═══════════════════════════════════════════════════════════════════════════
#
# Submit with:  qsub sweep/submit_sweep.pbs
#
# The array range should match the number of [[runs]] entries in params.toml.
# params_HsLs.toml currently has 19 runs → 1-19. Update if you add/remove.
#
# PATHS assume the post-migration layout (driver in src/sweep/). Before Nov
# 2026 this said "sweep/sweep_driver.jl", which no longer exists.
#═══════════════════════════════════════════════════════════════════════════


# ── Modules ────────────────────────────────────────────────────────────
module purge
module load ncarenv-basic/24.12
module load ncarenv/24.12
module load julia/1.11.2 cuda

module load peak-memusage
module li

# ── Environment ────────────────────────────────────────────────────────
# ── Per-machine settings ───────────────────────────────────────────────
# job_env.sh is gitignored and holds the account, email and Julia depot, so
# none of them live in this tracked file where a git pull would clobber them.
JOB_ENV="${PBS_O_WORKDIR:-$PWD}/src/sweep/job_env.sh"
if [ -f "${JOB_ENV}" ]; then
    # shellcheck source=/dev/null
    source "${JOB_ENV}"
    echo "sourced ${JOB_ENV}"
else
    echo "WARNING: ${JOB_ENV} not found — falling back to built-in defaults."
    echo "         cp src/sweep/job_env.sh.example src/sweep/job_env.sh"
fi

# Depot from job_env.sh if it set one, otherwise the known-good default.
# The TRAILING COLON matters: without it this replaces the depot list rather
# than prepending, dropping Julia's bundled stdlib depot and breaking Pkg.
export JULIA_DEPOT_PATH="${JULIA_DEPOT:-/glade/work/nguyen/.julia_v111:}"
echo "JULIA_DEPOT_PATH=${JULIA_DEPOT_PATH}"

# Project root (update this to your Casper path)
PROJECT_DIR="/glade/work/nguyen/unc-shoals"
cd "${PROJECT_DIR}"

# Create output and log directories
mkdir -p logs
mkdir -p output out/sweep sweep_output

# ── Launch ─────────────────────────────────────────────────────────────
echo "════════════════════════════════════════════════════════"
echo " PBS_ARRAY_INDEX = ${PBS_ARRAY_INDEX}"
echo " Host:             $(hostname)"
echo " GPU:              $(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null || echo 'N/A')"
echo " Date:             $(date)"
echo "════════════════════════════════════════════════════════"

peak_memusage julia --project=. src/sweep/sweep_driver.jl ${PBS_ARRAY_INDEX} 2>&1 | tee out/sweep/sweep_${PBS_ARRAY_INDEX}.log

echo "Job ${PBS_ARRAY_INDEX} finished at $(date)"
