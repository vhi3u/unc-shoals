#!/bin/bash -l
#═══════════════════════════════════════════════════════════════════════════
# Resolution check: 500 m vs 250 m across the shoal-height sweep
#═══════════════════════════════════════════════════════════════════════════
# Submit:  qsub src/sweep/submit_res250.pbs
#
# PATHS: this file assumes the post-migration layout, where the repo root is
# /glade/work/nguyen/unc-shoals and the driver lives in src/sweep/. Before
# Nov 2026 everything was flat at the root; the old scripts said
# "sweep/sweep_driver.jl" and would now fail.
#
# NOTE the -A account code below must be filled in and committed, or every
# git pull will hand you a script that cannot be submitted.
#═══════════════════════════════════════════════════════════════════════════

#PBS -A UOSC0035
#PBS -N res250
#PBS -k eod
#PBS -o logs/res250.out
#PBS -e logs/res250.err
#PBS -l walltime=04:00:00
#PBS -q casper
#PBS -l select=1:ncpus=4:ngpus=1:gpu_type=v100:mem=64gb
#PBS -m abe
#PBS -J 1-6

module purge
module load ncarenv-basic/24.12
module load ncarenv/24.12
module load julia/1.11.2 cuda
module load peak-memusage
module li

# Julia depot for the rebuilt 1.11 environment. The TRAILING COLON is
# required: without it this replaces the depot list instead of prepending,
# dropping Julia's bundled stdlib depot, which breaks Pkg itself.
export JULIA_DEPOT_PATH="/glade/work/nguyen/.julia_v111:"

# Which table in src/sweep/ the driver should read.
export SWEEP_PARAMS="params_res250.toml"

PROJECT_DIR="/glade/work/nguyen/unc-shoals"
cd "${PROJECT_DIR}"

mkdir -p logs out/sweep sweep_output

echo "════════════════════════════════════════════════════════"
echo " table:            ${SWEEP_PARAMS}"
echo " PBS_ARRAY_INDEX = ${PBS_ARRAY_INDEX}"
echo " Host:             $(hostname)"
echo " GPU:              $(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null || echo 'N/A')"
echo " Date:             $(date)"
echo "════════════════════════════════════════════════════════"

peak_memusage julia --project=. src/sweep/sweep_driver.jl ${PBS_ARRAY_INDEX} \
    2>&1 | tee out/sweep/res250_${PBS_ARRAY_INDEX}.log

echo "Job ${PBS_ARRAY_INDEX} finished at $(date)"
